<%- include('../partials/header') %>

<div class="container mt-page-end">
  <header class="page-header">
    <h1>Ledger</h1>
    <p class="page-lead">Every line is one movement of money. Edit or remove if something was mistyped.</p>
  </header>

  <div class="txn-table-wrap">
    <table class="txn-table">
      <thead>
        <tr>
          <th scope="col">Title</th>
          <th scope="col">Amount</th>
          <th scope="col">Type</th>
          <th scope="col">Category</th>
          <th scope="col">Date</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions.length === 0) { %>
          <tr>
            <td colspan="6" class="empty-state">Nothing logged yet. Add your first entry when you are ready.</td>
          </tr>
        <% } %>
        <% transactions.forEach(txn => { %>
          <tr>
            <td><%= txn.title %></td>
            <td class="num">₹<%= txn.amount %></td>
            <td>
              <span class="txn-type txn-type--<%= txn.IorE === 'income' ? 'income' : 'expense' %>">
                <%= txn.IorE === 'expence' ? 'expense' : txn.IorE %>
              </span>
            </td>
            <td><%= txn.category || '—' %></td>
            <td><%= txn.date ? txn.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></td>
            <td>
              <div class="txn-actions">
                <a class="btn-ledger btn-ledger--ghost btn-ledger--sm" href="/transactions/<%= txn._id %>/edit">Edit</a>
                <form action="/transactions/<%= txn._id %>/delete" method="POST" style="display:inline;">
                  <button type="submit" class="btn-ledger btn-ledger--danger btn-ledger--sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <p class="mt-4 mb-0">
    <a class="btn-ledger btn-ledger--primary" href="/transactions/add">New entry</a>
  </p>
</div>

<%- include('../partials/footer') %>
